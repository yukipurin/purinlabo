---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('log', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
---
<Base
  title="お知らせと開発記録"
  description="ぷりんラボのお知らせと開発記録。ツールやゲームの公開、作っているときに考えたことを書いています。"
>
  <div class="work">
    <h1 class="page-h1">お知らせと開発記録</h1>
    <p class="lead">公開のお知らせと、作っているときに考えたことを書いています。</p>

    <ul class="posts">
      {posts.map((post) => (
        <li>
          <div class="head">
            <a class="t" href={`/log/${post.id}/`}>{post.data.title}</a>
            <span class={post.data.kind === 'news' ? 'kind news' : 'kind'}>
              {post.data.kind === 'news' ? 'お知らせ' : '開発記録'}
            </span>
          </div>
          <p class="d">{fmt(post.data.date)}</p>
          <p>{post.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page-h1 { margin: 34px 0 6px; }
  .lead { margin-bottom: 26px; font-size: 15px; }
  .posts { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule); }
  .posts li { padding-block: 18px; border-bottom: 1px dashed var(--rule); }
  .head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .t { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--ink); text-decoration: none; }
  .t:hover { color: var(--tape-d); text-decoration: underline; }
  .kind {
    font-size: 11px; font-weight: 700; letter-spacing: .08em; color: var(--kraft-deep);
    border: 1.5px solid var(--kraft); padding: 0 8px;
    border-radius: 5px 2px 6px 3px / 3px 6px 2px 5px;
  }
  .kind.news { color: var(--tape-d); border-color: var(--tape); }
  .d { font-size: 12px; color: var(--ink3); margin-top: 3px; }
  .posts li > p:last-child { margin-top: 4px; font-size: 13.5px; }
</style>
