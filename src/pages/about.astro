---
import Base from '../layouts/Base.astro';
import { about as t } from '../content/about';
---
<Base
  title={t.title}
  description="ぷりんラボは、ひとりでゲームアプリとWebツールを作っている個人の開発スタジオです。"
>
  <section class="band head">
    <div class="read">
      <p class="label">{t.label}</p>
      <h1 class="display-lg">{t.title}</h1>
      {t.body.map((para) => <p class="lead muted">{para}</p>)}
    </div>
  </section>

  <section class="band band-deep">
    <div class="read">
      <h2 class="display-md">{t.linksTitle}</h2>
      <ul class="links">
        {t.links.map((l) => <li><a href={l.href} rel="noopener">{l.label}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="read">
      <h2 class="display-md">{t.contactTitle}</h2>
      <p class="muted"><a href={t.contactHref} rel="noopener">{t.contactBody}</a></p>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: 96px 72px; }
  .head .label { margin-bottom: 24px; }
  .head h1 { margin-bottom: 24px; }
  .head .lead + .lead { margin-top: 18px; }
  .links { list-style: none; display: flex; flex-direction: column; gap: 12px; margin: 28px 0 0; padding: 0; font-size: 16px; }
  h2 + p { margin-top: 20px; }
  @media (max-width: 700px) { .head { padding-block: 64px 48px; } }
</style>
