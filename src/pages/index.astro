---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { games } from '../content/games';
import { home as t } from '../content/home';

const posts = (await getCollection('log', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

---
<Base
  title="ぷりんラボ｜ゲームと、アップロードしないWebツールを作っています"
  description="ひとりでゲームアプリとWebツールを作っている開発スタジオです。Webツールはブラウザ内で完結し、ファイルを外部に送信しません。異世界ケルト音楽の作業用BGMも公開しています。"
>
  <!-- 帯1：紙。名乗る -->
  <section class="band hero">
    <div class="read hero-in">
      <div>
        <p class="label">{t.heroLabel}</p>
        <h1 class="display-xl" set:html={t.heroTitle} />
        <p class="lead muted">{t.heroLead}</p>
      </div>
      <figure class="riona">
        <picture>
          <source srcset="/img/riona.webp" type="image/webp" />
          <img src="/img/riona.jpg" width="584" height="620" alt="ぷりんラボのキャラクター、ハーフエルフのリオナ" />
        </picture>
        <figcaption class="muted">{t.rionaCaption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 帯2：濃いインク。やっていること -->
  <section class="band band-ink">
    <div class="read">
      <p class="label">{t.makeLabel}</p>
      <h2 class="display-lg">{t.makeTitle}</h2>
      <div class="three">
        {t.columns.map((c) => (
          <div>
            <h3 class="display-md">{c.title}</h3>
            <p class="muted">{c.body}</p>
            <p class="go"><a href={c.href} rel="noopener">{c.linkLabel}</a></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 帯3：紙。いま使えるツール -->
  <section class="band">
    <div class="read center">
      <p class="label">{t.toolLabel}</p>
      <h2 class="display-lg" set:html={t.toolTitle} />
      <p class="lead muted" set:html={t.toolLead} />
      <p class="cta"><a class="btn" href="/tools/square/">{t.toolCta}</a></p>
      <p class="sub"><a href="/tools/">{t.toolSub}</a></p>
    </div>
  </section>

  <!-- 帯4：濃い紙。ゲームは紹介ページへ送る -->
  <section class="band band-deep" id="games">
    <div class="read">
      <p class="label">{t.gamesLabel}</p>
      <h2 class="display-lg">{t.gamesTitle}</h2>
      <p class="lead muted">{t.gamesLead}</p>
      <ul class="icons">
        {games.map((g) => (
          <li><a href="/games/"><img src={`/img/games/${g.slug}-icon.webp`} width="72" height="72"
                 alt={g.name} loading="lazy" /></a></li>
        ))}
      </ul>
      <p class="cta"><a class="btn" href="/games/">{t.gamesCta}</a></p>
    </div>
  </section>

  <!-- 帯5：紙。お知らせ -->
  <section class="band">
    <div class="read">
      <p class="label">{t.logLabel}</p>
      <h2 class="display-lg">{t.logTitle}</h2>
      <ul class="list posts">
        {posts.map((post) => (
          <li>
            <p class="date muted">{fmt(post.data.date)}</p>
            <a href={`/log/${post.id}/`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <p class="go"><a href="/log/">{t.logMore}</a></p>
    </div>
  </section>
</Base>

<style>
  /* 帯どうしを罫線で区切らない。背景色の変化が区切り */

  .hero { padding-block: 128px 112px; }
  .hero-in {
    display: grid; grid-template-columns: 1fr minmax(0, 300px);
    gap: 64px; align-items: center;
  }
  .hero .label { margin-bottom: 28px; }
  .hero h1 { margin-bottom: 32px; }
  .hero .lead { max-width: 30em; }

  .riona { margin: 0; }
  /* 白背景の一枚絵を紙に馴染ませる。枠を付けずに済ませるため乗算で抜く */
  .riona img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .riona figcaption { margin-top: 14px; font-size: 12px; letter-spacing: .06em; }

  .label + h2 { margin-top: 26px; }
  h2 + .three, h2 + .list, h2 + .lead { margin-top: 48px; }

  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px; }
  .three h3 { margin-bottom: 14px; }
  .go { margin-top: 18px; font-size: 14px; }

  .center { text-align: center; }
  .center .lead { margin-inline: auto; }
  .cta { margin-top: 44px; }
  .sub { margin-top: 24px; font-size: 14px; }
  .sp { display: none; }

  /* 一覧はカードにせず、間隔だけで分ける */
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { margin-bottom: 36px; }
  .list li:last-child { margin-bottom: 0; }
  .list a {
    font-family: var(--display); font-weight: 700; font-size: 21px;
    color: inherit; text-decoration: none;
  }
  .list a:hover { color: var(--tape-d); text-decoration: underline; }
  .list p { margin-top: 6px; font-size: 15px; }
  .posts .date { font-size: 12px; letter-spacing: .12em; margin-bottom: 6px; }
  .icons { list-style: none; display: flex; gap: 16px; flex-wrap: wrap; margin: 36px 0 0; padding: 0; }
  .icons img { display: block; border-radius: 16px; }
  .cta { margin-top: 40px; }

  @media (max-width: 860px) {
    .hero { padding-block: 80px 72px; }
    .hero-in { grid-template-columns: 1fr; gap: 44px; }
    .riona { max-width: 230px; }
    .three { grid-template-columns: 1fr; gap: 40px; }
    h2 + .three, h2 + .list, h2 + .lead { margin-top: 32px; }
    .sp { display: inline; }
  }
</style>
