---
import Base from '../layouts/Base.astro';

const games = [
  { name: '創世のマナ', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780463661',
    note: 'マナを紡いで世界を創る、静かな放置ゲーム。' },
  { name: '誤変換大戦', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6787645238',
    note: '「魔王を倒した」が「魔王を倒産した」に。変換ミスで世界が暴走する言葉のバカゲー。' },
  { name: 'ことば仕分け帳', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6781580333',
    note: '「暑い」「熱い」「厚い」を仕分ける、日本語の語彙パズル。' },
  { name: '周期リマインダー', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780852897',
    note: 'フィルター交換や水やりなど、◯日ごとのやることを憶えておく道具。' },
  { name: 'のんびり異世界釣り', tag: null, href: null,
    note: '影の形と動きから幻の魚を見立てる、釣り×図鑑。' },
  { name: '忘れもの郵便局', tag: null, href: null,
    note: '五つの支局を育てる、2Dドット絵の箱庭放置経営ゲーム。' },
  { name: '推し日和', tag: null, href: null,
    note: '推しへの気持ちを毎日ひとことだけ記録する帳面。' },
];
---
<Base
  title="ぷりんラボ｜アップロード不要の無料Webツールと、個人開発のゲーム"
  description="写真やファイルをアップロードせずに使える無料Webツールと、個人で作っているゲーム・アプリを置いています。登録不要、インストール不要。"
>
  <h1 class="page-h1">ファイルを<span class="mark">どこにも送らない</span>道具と、ひとりで作るゲーム。</h1>
  <p class="lead">ぷりんラボは、ひとりでゲームとWebツールを作っている小さな作業場です。ツールの処理はすべてブラウザ内で行います。</p>

  <section>
    <h2>ツール<span class="rule-wave"></span></h2>
    <div class="hand-box pick">
      <p class="t">出品写真をまとめて正方形にする</p>
      <p class="d">複数枚まとめて1080×1080に。アップロード不要、登録不要。</p>
      <p><a class="btn" href="/tools/square/">使ってみる</a></p>
    </div>
    <p class="more"><a href="/tools/">ほかのツールを見る</a></p>
  </section>

  <section id="games">
    <h2>ゲーム・アプリ<span class="rule-wave"></span></h2>
    <ul class="shelf">
      {games.map((g) => (
        <li class="row">
          <div class="head">
            {g.href ? <a class="name" href={g.href} rel="noopener">{g.name}</a>
                    : <span class="name">{g.name}</span>}
            {g.tag ? <span class="tag">{g.tag}</span> : <span class="stamp">準備中</span>}
          </div>
          <p>{g.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="who">
    <h2>ぷりんラボについて<span class="rule-wave"></span></h2>
    <p>ひとりでゲームアプリとWebツールを作っています。YouTubeでは異世界ケルト音楽の作業用BGMを公開しています。</p>
    <ul class="links">
      <li><a href="https://www.youtube.com/@soundlibrarystudio" rel="noopener">音の図書館（YouTube）</a></li>
      <li><a href="https://x.com/Purin_Labo" rel="noopener">X</a></li>
    </ul>
  </section>
</Base>

<style>
  .page-h1 { margin: 40px 0 10px; }
  .lead { margin-bottom: 8px; font-size: 15px; }
  section { margin-top: 44px; }
  h2 { display: flex; align-items: center; gap: 9px; margin-bottom: 14px; }

  .pick { padding: 20px 22px; }
  .pick .t { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--ink); margin: 0; }
  .pick .d { margin: 4px 0 14px; font-size: 13.5px; }
  .more { margin-top: 14px; font-size: 13.5px; }

  .shelf { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule); }
  .row { padding-block: 16px; border-bottom: 1px dashed var(--rule); }
  .head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .name { font-family: var(--display); font-weight: 700; font-size: 16px; color: var(--ink); text-decoration: none; }
  a.name:hover { color: var(--tape-d); text-decoration: underline; }
  .tag { font-size: 11px; font-weight: 700; letter-spacing: .1em; color: var(--kraft-d); border: 1.5px solid var(--kraft); padding: 0 8px; border-radius: 5px 2px 6px 3px / 3px 6px 2px 5px; }
  .row p { margin-top: 2px; font-size: 13.5px; }

  .who { border-top: 2px solid var(--rule); padding-top: 22px; }
  ul.links { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; margin: 12px 0 0; padding: 0; font-size: 14px; }
</style>
