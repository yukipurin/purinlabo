---
import Base from '../layouts/Base.astro';

const games = [
  { name: '創世のマナ', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780463661',
    note: 'マナを紡いで世界を創る、静かな放置ゲーム。無から森が、海が、文明が生まれる。' },
  { name: '誤変換大戦', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6787645238',
    note: '「魔王を倒した」が「魔王を倒産した」に。変換ミスで世界が暴走する、言葉のバカゲー。' },
  { name: 'ことば仕分け帳', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6781580333',
    note: '「暑い」「熱い」「厚い」、ちゃんと仕分けられる？ 日本語の語彙を棚に整える短時間パズル。' },
  { name: '周期リマインダー', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780852897',
    note: 'フィルター交換、植物の水やり。「◯日ごとのやること」を静かに憶えておく道具。' },
  { name: 'のんびり異世界釣り', tag: '準備中', href: null,
    note: '影の形、動きの速さ、時間帯。手がかりを読んで幻の魚を見立てる、癒し系の釣り×図鑑。' },
  { name: '忘れもの郵便局', tag: '準備中', href: null,
    note: '切手の桁を伸ばし、五つの支局を育てる。細密な2Dドット絵の箱庭放置経営ゲーム。' },
  { name: '推し日和', tag: '準備中', href: null,
    note: '推しへの気持ちを、毎日ひとことだけ。推し活の記録帳。' },
];

const points = [
  { t: 'アップロードしない', d: '写真もファイルも、あなたのパソコンやスマホから出ません。' },
  { t: '登録もインストールも不要', d: 'ページを開いたらすぐ使えます。会員登録はありません。' },
  { t: 'スマホでも使える', d: '出先でも、パソコンと同じことができます。' },
];
---
<Base
  title="Purin_Labo — アップロードしないで使える無料ツールと、ひとりで作るゲーム"
  description="写真やファイルをアップロードせずに使える無料Webツールと、個人開発のゲーム・アプリ。登録不要、インストール不要。すべてブラウザの中だけで動きます。"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">無料・登録不要</p>
        <h1>ファイルを<br />どこにも送らない道具。</h1>
        <p class="lede">
          写真の加工も変換も、ぜんぶブラウザの中だけで終わります。
          アップロードしないので、待ち時間もありません。
        </p>
        <p class="hero-cta">
          <a class="btn" href="/tools/">ツールを見る</a>
          <a class="btn-quiet" href="#games">ゲームを見る</a>
        </p>
      </div>

      <figure class="signature" aria-labelledby="sig-cap">
        <svg viewBox="0 0 320 160" role="img" aria-label="ファイルが端末の中だけで処理され、外部のサーバーへは送信されない仕組みの図">
          <rect x="8" y="12" width="196" height="124" rx="12"
                fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2" />
          <text x="24" y="36" class="sig-label" fill="var(--accent-deep)">あなたのパソコン・スマホ</text>

          <rect x="36" y="62" width="34" height="46" rx="5"
                fill="var(--surface)" stroke="var(--ink-weak)" stroke-width="2" />
          <path d="M45 76h16M45 85h16M45 94h10" stroke="var(--ink-weak)" stroke-width="2" stroke-linecap="round" />

          <path d="M84 85h20" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" />
          <path d="M99 79l6 6-6 6" fill="none" stroke="var(--accent)" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />

          <rect x="118" y="62" width="34" height="46" rx="5"
                fill="var(--surface)" stroke="var(--accent)" stroke-width="2" />
          <path d="M126 85l6 7 13-15" fill="none" stroke="var(--accent)" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round" />

          <path d="M212 85h44" stroke="var(--ink-weak)" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
          <circle cx="234" cy="85" r="14" fill="var(--ground)" stroke="var(--line)" stroke-width="2" />
          <path d="M229 80l10 10M239 80l-10 10" stroke="var(--ink-weak)" stroke-width="2.5" stroke-linecap="round" />

          <rect x="266" y="64" width="46" height="42" rx="6"
                fill="none" stroke="var(--ink-weak)" stroke-width="2" />
          <path d="M276 77h20M276 93h20" stroke="var(--ink-weak)" stroke-width="2" stroke-linecap="round" />
          <text x="266" y="126" class="sig-label" fill="var(--ink-weak)">サーバー</text>
        </svg>
        <figcaption id="sig-cap" class="small muted">
          処理はぜんぶブラウザの中。送信も保存もしません。
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap block">
      <ul class="points">
        {points.map((p) => (
          <li>
            <h3>{p.t}</h3>
            <p class="muted small">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap block" id="tools">
    <p class="eyebrow">Tools</p>
    <h2>無料Webツール</h2>
    <p class="lede">
      フリマやネットショップの出品作業を、ちょっと短くする道具から作っています。
    </p>
    <p class="mt"><a class="btn" href="/tools/">これから出るツールを見る</a></p>
  </section>

  <section class="band-warm">
    <div class="wrap block" id="games">
      <p class="eyebrow warm">Games &amp; Apps</p>
      <h2>作ったゲーム・アプリ</h2>
      <ul class="shelf">
        {games.map((g) => (
          <li class="shelf-row">
            <div class="shelf-head">
              {g.href
                ? <a class="shelf-name" href={g.href} rel="noopener">{g.name}</a>
                : <span class="shelf-name">{g.name}</span>}
              <span class={g.href ? 'tag' : 'tag soon'}>{g.tag}</span>
            </div>
            <p class="muted small">{g.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap block" id="about">
    <p class="eyebrow">About</p>
    <h2>Purin_Labo について</h2>
    <p>
      ぷりんラボは、ひとりでやっている小さな開発スタジオです。
      ゲームと、iPhoneアプリと、無料のWebツールを作っています。
    </p>
    <p class="mt muted">
      作るかどうかの基準はひとつだけで、「自分が使いたいか」。
      使わなくなったものは、静かに畳みます。
    </p>
    <p class="mt small muted">
      ご連絡は <a href="https://x.com/Purin_Labo" rel="noopener">@Purin_Labo</a> まで。
    </p>
  </section>
</Base>

<style>
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 350px);
    gap: var(--s7);
    align-items: center;
    padding-block: var(--s7) var(--s8);
  }
  .hero h1 { margin-bottom: var(--s4); }
  .hero-cta { display: flex; gap: var(--s3); margin-top: var(--s5); flex-wrap: wrap; }

  .signature svg { width: 100%; display: block; }
  .signature { margin: 0; }
  .signature figcaption { margin-top: var(--s2); }
  :global(.sig-label) { font-size: 11px; font-weight: 700; letter-spacing: .04em; font-family: var(--font-body); }

  .block { padding-block: var(--s7); }
  .mt { margin-top: var(--s4); }

  /* 3点の要約。カードにせず、上に色罫を引いた列で並べる */
  .points {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s5);
  }
  .points li { border-top: 3px solid var(--accent); padding-top: var(--s3); }
  .points h3 { margin-bottom: var(--s1); }

  /* 一覧は罫線で仕切った「棚」。カードを敷き詰めない */
  .shelf { list-style: none; margin: var(--s5) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .shelf-row { padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .shelf-head { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  .shelf-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
  }
  a.shelf-name:hover { color: var(--accent-deep); text-decoration: underline; }
  .tag {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--accent-on);
    background: var(--accent);
    border-radius: 999px;
    padding: 1px 12px;
    line-height: 1.6;
  }
  .tag.soon { color: var(--ink-mute); background: transparent; border: 1px solid var(--line); }
  .shelf-row p { margin-top: var(--s1); }

  @media (max-width: 52rem) {
    .hero-inner { grid-template-columns: 1fr; gap: var(--s6); padding-block: var(--s6); }
    .signature { max-width: 350px; }
    .points { grid-template-columns: 1fr; gap: var(--s4); }
  }
</style>
