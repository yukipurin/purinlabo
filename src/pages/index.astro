---
import Base from '../layouts/Base.astro';

const games = [
  { name: '創世のマナ', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780463661',
    note: 'マナを紡いで世界を創る、静かな放置ゲーム。無から森が、海が、文明が生まれる。' },
  { name: '誤変換大戦', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6787645238',
    note: '「魔王を倒した」が「魔王を倒産した」に。変換ミスで世界が暴走する、言葉のバカゲー。' },
  { name: 'ことば仕分け帳', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6781580333',
    note: '「暑い」「熱い」「厚い」、ちゃんと仕分けられる？ 日本語の語彙を棚に整える短時間パズル。' },
  { name: '周期リマインダー', tag: 'iOS', href: 'https://apps.apple.com/jp/app/id6780852897',
    note: 'フィルター交換、植物の水やり。「◯日ごとのやること」を静かに憶えておく道具。' },
  { name: 'のんびり異世界釣り', tag: '準備中', href: null,
    note: '影の形、動きの速さ、時間帯。手がかりを読んで幻の魚を見立てる、癒し系の釣り×図鑑。' },
  { name: '忘れもの郵便局', tag: '準備中', href: null,
    note: '切手の桁を伸ばし、五つの支局を育てる。細密な2Dドット絵の箱庭放置経営ゲーム。' },
  { name: '推し日和', tag: '準備中', href: null,
    note: '推しへの気持ちを、毎日ひとことだけ。推し活の記録帳。' },
];
---
<Base
  title="Purin_Labo — ブラウザの中で完結する道具と、ひとりで作るゲーム"
  description="アップロードなしで使える無料Webツールと、個人開発のゲーム・アプリを置いている店。ファイルはあなたの端末から出ません。"
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>道具は、<br />端末の外に出さない。</h1>
        <p class="lede">
          Purin_Labo は、ひとりで作った道具とゲームを並べている店です。
          Webツールはすべてブラウザの中だけで動きます。ファイルはどこにも送られません。
        </p>
        <p class="hero-cta">
          <a class="btn" href="/tools/">ツールを見る</a>
          <a class="btn-quiet" href="#games">ゲームを見る</a>
        </p>
      </div>

      <figure class="signature" aria-labelledby="sig-cap">
        <svg viewBox="0 0 320 160" role="img" aria-label="ファイルが端末の中だけで処理され、外部のサーバーへは送信されない仕組みの図">
          <!-- あなたの端末：この枠の中で全部が完結する -->
          <rect x="8" y="12" width="196" height="124" rx="3"
                fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5" />
          <text x="20" y="32" class="sig-label" fill="var(--accent)">あなたの端末</text>

          <!-- 元のファイル -->
          <rect x="36" y="62" width="34" height="44" rx="2"
                fill="none" stroke="var(--ink-mute)" stroke-width="1.5" />
          <path d="M44 74h18M44 82h18M44 90h11" stroke="var(--ink-weak)" stroke-width="1.5" />

          <!-- 処理 -->
          <path d="M82 84h24" stroke="var(--accent)" stroke-width="1.5" />
          <path d="M100 79l6 5-6 5" fill="none" stroke="var(--accent)" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" />

          <!-- 処理後のファイル -->
          <rect x="118" y="62" width="34" height="44" rx="2"
                fill="var(--accent-wash)" stroke="var(--accent)" stroke-width="1.5" />
          <path d="M126 84l6 6 12-14" fill="none" stroke="var(--accent)" stroke-width="1.75"
                stroke-linecap="round" stroke-linejoin="round" />

          <!-- 外へ出ようとする経路が断たれている -->
          <path d="M212 84h44" stroke="var(--ink-weak)" stroke-width="1.5" stroke-dasharray="3 4" />
          <circle cx="234" cy="84" r="12" fill="var(--ground)" />
          <path d="M228 78l12 12M240 78l-12 12" stroke="var(--ink-weak)" stroke-width="1.75"
                stroke-linecap="round" />

          <!-- サーバー（使わない） -->
          <rect x="264" y="64" width="46" height="40" rx="2"
                fill="none" stroke="var(--ink-weak)" stroke-width="1.5" />
          <path d="M272 76h20M272 92h20" stroke="var(--ink-weak)" stroke-width="1.5" />
          <circle cx="302" cy="76" r="1.75" fill="var(--ink-weak)" />
          <circle cx="302" cy="92" r="1.75" fill="var(--ink-weak)" />
          <text x="264" y="122" class="sig-label" fill="var(--ink-weak)">サーバー</text>
        </svg>
        <figcaption id="sig-cap" class="small muted">
          処理はすべてブラウザ内。送信も保存もありません。
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap block" id="tools">
    <h2 class="eyebrow">Tools</h2>
    <div class="panel notice">
      <h3>無料Webツール</h3>
      <p class="muted">
        フリマ・ネットショップの出品作業を短くする画像の道具から作っています。
        登録なし、インストールなし、アップロードなし。
      </p>
      <p><a href="/tools/">準備中のツール一覧を見る</a></p>
    </div>
  </section>

  <section class="wrap block" id="games">
    <h2 class="eyebrow">Games &amp; Apps</h2>
    <ul class="shelf">
      {games.map((g) => (
        <li class="shelf-row">
          <div class="shelf-head">
            {g.href
              ? <a class="shelf-name" href={g.href} rel="noopener">{g.name}</a>
              : <span class="shelf-name">{g.name}</span>}
            <span class="tag">{g.tag}</span>
          </div>
          <p class="muted small">{g.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block" id="about">
    <h2 class="eyebrow">About</h2>
    <p>
      Purin_Labo（ぷりんラボ）は、ひとりで運営している開発スタジオです。
      ゲーム、iPhoneアプリ、無料のWebツールを作っています。
    </p>
    <p class="muted">
      作るものの基準はひとつだけで、
      「自分が使いたいか」です。使わなくなったものは、静かに畳みます。
    </p>
    <p class="small muted">
      お問い合わせ：<a href="https://x.com/Purin_Labo" rel="noopener">@Purin_Labo</a>
    </p>
  </section>
</Base>

<style>
  .hero { background: var(--surface); border-bottom: 1px solid var(--line); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr minmax(0, 340px);
    gap: var(--s7);
    align-items: center;
    padding-block: var(--s8);
  }
  .hero h1 { letter-spacing: .06em; }
  .hero .lede { margin-top: var(--s4); }
  .hero-cta { display: flex; gap: var(--s3); margin-top: var(--s5); flex-wrap: wrap; }

  .btn {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-on);
    text-decoration: none;
    padding: var(--s2) var(--s4);
    border-radius: var(--radius);
    letter-spacing: .08em;
  }
  .btn:hover { background: var(--accent-deep); color: var(--accent-on); }
  .btn-quiet {
    display: inline-block;
    color: var(--ink-mute);
    text-decoration: none;
    padding: var(--s2) var(--s4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    letter-spacing: .08em;
  }
  .btn-quiet:hover { border-color: var(--accent); color: var(--accent); }

  .signature { margin: 0; }
  .signature svg { width: 100%; display: block; }
  .signature figcaption { margin-top: var(--s2); }
  :global(.sig-label) { font-size: 11px; letter-spacing: .14em; font-family: var(--font-body); }

  .block { padding-block: var(--s7); }

  .notice { padding: var(--s5); }
  .notice h3 { margin-bottom: var(--s2); }
  .notice p { margin-bottom: var(--s3); }
  .notice p:last-child { margin-bottom: 0; }

  /* カードを敷き詰めず、罫線で仕切った棚として並べる */
  .shelf { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-soft); }
  .shelf-row { padding-block: var(--s4); border-bottom: 1px solid var(--line-soft); }
  .shelf-head { display: flex; align-items: baseline; gap: var(--s3); }
  .shelf-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: .06em;
    color: var(--ink);
    text-decoration: none;
  }
  a.shelf-name:hover { color: var(--accent); text-decoration: underline; }
  .tag {
    font-size: var(--step--1);
    letter-spacing: .16em;
    color: var(--gold);
    white-space: nowrap;
  }
  .shelf-row p { margin-top: var(--s1); }

  #about p + p { margin-top: var(--s3); }

  @media (max-width: 52rem) {
    .hero-inner { grid-template-columns: 1fr; gap: var(--s6); padding-block: var(--s6); }
    .signature { max-width: 340px; }
  }
</style>
