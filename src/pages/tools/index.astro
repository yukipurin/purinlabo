---
import Base from '../../layouts/Base.astro';

// ツールを1本足す＝この配列に1行足して、同名のページを作る。
const tools = [
  { slug: 'square', name: '出品写真をまとめて正方形にする', ready: true,
    note: '複数枚まとめて1080×1080に。余白は白で埋めるか、切り抜くかを選べます。' },
  { slug: 'resize', name: '画像を一括リサイズ', ready: false,
    note: '長辺を指定して、比率を保ったまままとめて縮小します。' },
  { slug: 'compress', name: '画像を軽くする', ready: false,
    note: '目標のファイルサイズを指定すると、画質を自動で調整します。' },
  { slug: 'heic', name: 'HEICをJPGに変換', ready: false,
    note: 'iPhoneで撮った写真を、Windowsでも開ける形式にまとめて変換します。' },
  { slug: 'rename', name: '連番でリネームしてZIP', ready: false,
    note: '商品ごとに01、02と番号を振り直して、まとめて書き出します。' },
];
---
<Base
  title="無料Webツール"
  description="アップロード不要・登録不要の無料Webツール。フリマやネットショップの出品画像を、ブラウザの中だけで一括処理します。"
>
  <h1 class="page-h1">ツール</h1>
  <p class="lead">フリマ・ネットショップの出品作業を短くするための道具です。処理はすべてブラウザ内で行います。</p>

  <ul class="shelf">
    {tools.map((tool) => (
      <li class={tool.ready ? 'row' : 'row soon'}>
        <div class="head">
          {tool.ready
            ? <a class="name" href={`/tools/${tool.slug}/`}>{tool.name}</a>
            : <span class="name">{tool.name}</span>}
          {!tool.ready && <span class="stamp">準備中</span>}
        </div>
        <p>{tool.note}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .page-h1 { margin: 34px 0 6px; }
  .lead { margin-bottom: 26px; font-size: 15px; }
  .shelf { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--rule); }
  .row { padding-block: 18px; border-bottom: 1px dashed var(--rule); }
  .head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .name { font-family: var(--display); font-weight: 700; font-size: 17px; color: var(--ink); text-decoration: none; }
  a.name:hover { color: var(--tape-d); text-decoration: underline; }
  .row.soon .name { color: var(--ink3); }
  .row p { margin-top: 2px; font-size: 13.5px; }
</style>
