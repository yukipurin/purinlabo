---
import Base from '../../layouts/Base.astro';
import { toolsPage as t, tools } from '../../content/tools';

const ready = tools.filter((x) => x.ready);
const soon = tools.filter((x) => !x.ready);
---
<Base
  title="無料Webツール"
  description="アップロード不要・登録不要の無料Webツール。フリマやネットショップの出品画像を、ブラウザの中だけで一括処理します。"
>
  <section class="band head">
    <div class="read">
      <p class="label">{t.label}</p>
      <h1 class="display-lg">{t.title}</h1>
      <p class="lead muted">{t.lead}</p>
    </div>
  </section>

  {ready.map((x) => (
    <section class="band band-deep">
      <div class="read">
        <h2 class="display-md">{x.name}</h2>
        <p class="lead2">{x.lead}</p>
        {x.image && (
          <figure class="fig">
            <img src={x.image} width="940" height="360" alt={x.imageAlt} loading="lazy" />
            {x.imageCaption && <figcaption class="muted">{x.imageCaption}</figcaption>}
          </figure>
        )}
        {x.body && <p class="body muted">{x.body}</p>}
        <p class="cta"><a class="btn" href={`/tools/${x.slug}/`}>{t.cta}</a></p>
      </div>
    </section>
  ))}

  <section class="band">
    <div class="read">
      <p class="label">{t.soonLabel}</p>
      <h2 class="display-lg">{t.soonTitle}</h2>
      <ul class="soon">
        {soon.map((x) => (
          <li><strong>{x.name}</strong><p class="muted">{x.lead}</p></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: 96px 72px; }
  .head .label { margin-bottom: 24px; }
  .head h1 { margin-bottom: 20px; }
  .lead2 { margin-top: 10px; font-size: 17px; }
  .fig { margin: 36px 0 0; }
  .fig img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .fig figcaption { margin-top: 12px; font-size: 13px; }
  .body { margin-top: 28px; max-width: 34em; font-size: 15px; }
  .cta { margin-top: 32px; }
  .soon { list-style: none; margin: 40px 0 0; padding: 0; }
  .soon li { margin-bottom: 28px; }
  .soon strong { font-family: var(--display); font-size: 19px; }
  .soon p { margin-top: 4px; font-size: 15px; }
  @media (max-width: 700px) { .head { padding-block: 64px 48px; } }
</style>
