---
import Base from '../../layouts/Base.astro';
import { square as t } from '../../content/square';
---
<Base
  title="出品写真をまとめて正方形にする"
  description="メルカリ・ヤフオク・BASEの出品写真を1080×1080の正方形に一括変換します。アップロード不要・登録不要。処理はすべてブラウザ内で行います。"
>
  <div class="work">
    <h1 class="page-h1" set:html={t.title.replace(t.titleMark, `<span class="mark">${t.titleMark}</span>`)} />
    <p class="lead">{t.lead}</p>

    <div class="hand-box tool">
      <div id="dropzone" class="hand-dash drop">
        <div class="pics"><i></i><i></i><i></i></div>
        <p class="big">{t.dropTitle}</p>
        <p class="note">{t.dropNote}</p>
        <button id="pick" class="btn" type="button">{t.button}</button>
        <p class="under">{t.buttonNote}</p>
        <input id="file" type="file" accept="image/*" multiple hidden />
      </div>

      <div id="settings" class="form" hidden>
        <div class="row">
          <label for="size">{t.settingSize}</label>
          <select id="size">
            <option value="1080" selected>1080 × 1080</option>
            <option value="1200">1200 × 1200</option>
            <option value="800">800 × 800</option>
          </select>
        </div>
        <div class="row">
          <label for="fill">{t.settingFill}</label>
          <select id="fill">
            {t.fillOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div class="row">
          <label for="prefix">{t.settingName}</label>
          <input id="prefix" type="text" placeholder={t.settingNamePlaceholder} />
        </div>
        <div class="actions">
          <button id="run" class="btn" type="button">{t.runButton}</button>
          <button id="clear" class="link-btn" type="button">{t.clearButton}</button>
          <span id="count" class="count"></span>
        </div>
      </div>

      <p class="safe">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1.6l5.4 2v3.9c0 3.1-2.2 5.9-5.4 6.9-3.2-1-5.4-3.8-5.4-6.9V3.6l5.4-2z"
                stroke="#2c6b4b" stroke-width="1.7" stroke-linejoin="round"/>
        </svg>
        <span>{t.privacy}</span>
      </p>
    </div>

    <section id="results" hidden>
      <h2>{t.resultHeading}<span class="rule-wave"></span></h2>
      <p class="actions"><button id="zip" class="btn" type="button">{t.downloadZip}</button></p>
      <ul id="grid" class="grid"></ul>
    </section>

    <section>
      <h2>{t.stepsTitle}<span class="rule-wave"></span></h2>
      <ol class="steps">
        {t.steps.map((step, i) => <li><span class="n">{i + 1}</span><span>{step}</span></li>)}
      </ol>
    </section>

    <section>
      <h2>{t.limitsTitle}<span class="rule-wave"></span></h2>
      <ul class="cant">{t.limits.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="who">
      <h2>{t.aboutTitle}<span class="rule-wave"></span></h2>
      {t.about.map((para) => <p>{para}</p>)}
      <ul class="links">
        {t.aboutLinks.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}
      </ul>
      <p class="stamp-wrap"><span class="stamp">{t.stamp}</span></p>
    </section>
  </div>
</Base>

<script>
  import { zipSync } from 'fflate';
  import { fitContain, fitCover, formatBytes, outputName } from '../../lib/square';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const dropzone = $<HTMLDivElement>('dropzone');
  const fileInput = $<HTMLInputElement>('file');
  const settings = $<HTMLDivElement>('settings');
  const results = $<HTMLElement>('results');
  const grid = $<HTMLUListElement>('grid');
  const runBtn = $<HTMLButtonElement>('run');
  const zipBtn = $<HTMLButtonElement>('zip');
  const countEl = $<HTMLSpanElement>('count');

  let picked: File[] = [];
  let made: { name: string; blob: Blob; url: string }[] = [];

  function reset() {
    made.forEach((m) => URL.revokeObjectURL(m.url));
    made = [];
    grid.innerHTML = '';
    results.hidden = true;
  }

  function setFiles(list: FileList | null) {
    if (!list || list.length === 0) return;
    picked = Array.from(list).filter((f) => f.type.startsWith('image/') || /\.hei[cf]$/i.test(f.name));
    reset();
    settings.hidden = picked.length === 0;
    countEl.textContent = picked.length > 0 ? `${picked.length}枚選択中` : '';
  }

  $<HTMLButtonElement>('pick').addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', () => setFiles(fileInput.files));

  ['dragenter', 'dragover'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((ev) =>
    dropzone.addEventListener(ev, (e) => { e.preventDefault(); dropzone.classList.remove('over'); }));
  dropzone.addEventListener('drop', (e) => setFiles((e as DragEvent).dataTransfer?.files ?? null));

  $<HTMLButtonElement>('clear').addEventListener('click', () => {
    picked = []; fileInput.value = ''; settings.hidden = true; countEl.textContent = ''; reset();
  });

  async function convert(file: File, size: number, mode: string): Promise<Blob> {
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = size; canvas.height = size;
    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('canvas を使えません');
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, size, size);
    ctx.imageSmoothingQuality = 'high';

    if (mode === 'cover') {
      const s = fitCover(bitmap.width, bitmap.height, size);
      ctx.drawImage(bitmap, s.dx, s.dy, s.dw, s.dh, 0, 0, size, size);
    } else {
      const d = fitContain(bitmap.width, bitmap.height, size);
      ctx.drawImage(bitmap, d.dx, d.dy, d.dw, d.dh);
    }
    bitmap.close();

    return await new Promise<Blob>((resolve, reject) =>
      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('書き出しに失敗しました'))), 'image/jpeg', 0.92));
  }

  runBtn.addEventListener('click', async () => {
    if (picked.length === 0) return;
    const size = Number($<HTMLSelectElement>('size').value);
    const mode = $<HTMLSelectElement>('fill').value;
    const prefix = $<HTMLInputElement>('prefix').value;

    reset();
    results.hidden = false;
    runBtn.disabled = true;
    const original = runBtn.textContent;

    for (let i = 0; i < picked.length; i++) {
      const file = picked[i];
      runBtn.textContent = `変換しています… ${i + 1} / ${picked.length}`;
      const li = document.createElement('li');
      try {
        const blob = await convert(file, size, mode);
        const name = outputName(file.name, i, picked.length, prefix);
        const url = URL.createObjectURL(blob);
        made.push({ name, blob, url });
        li.innerHTML =
          `<a href="${url}" download="${name}"><img src="${url}" alt="" width="120" height="120" loading="lazy"></a>` +
          `<span class="fn">${name}</span><span class="sz">${formatBytes(blob.size)}</span>`;
      } catch {
        li.className = 'ng';
        li.innerHTML = `<span class="fn">${file.name}</span><span class="sz">この形式はこのブラウザで開けません</span>`;
      }
      grid.appendChild(li);
    }

    runBtn.textContent = original;
    runBtn.disabled = false;
    zipBtn.hidden = made.length === 0;
  });

  zipBtn.addEventListener('click', async () => {
    if (made.length === 0) return;
    const entries: Record<string, Uint8Array> = {};
    for (const m of made) entries[m.name] = new Uint8Array(await m.blob.arrayBuffer());
    // JPEGは圧縮済みなので無圧縮(level:0)で束ねる。速いしサイズもほぼ変わらない
    const zipped = zipSync(entries, { level: 0 });
    const url = URL.createObjectURL(new Blob([zipped as BlobPart], { type: 'application/zip' }));
    const a = document.createElement('a');
    a.href = url; a.download = 'square.zip'; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 10_000);
  });
</script>

<style>
  .page-h1 { margin: 34px 0 6px; }
  .lead { margin-bottom: 22px; font-size: 15px; }

  .tool { padding: 20px; }
  .drop { background: #fffef9; padding: 40px 16px; text-align: center; }
  .drop.over { border-color: var(--tape); background: #f4fbf7; }
  .pics { display: flex; gap: 9px; justify-content: center; margin-bottom: 16px; }
  .pics i { width: 42px; height: 42px; display: block; border: 2px solid var(--kraft-deep); border-radius: 3px; }
  .pics i:nth-child(1) { background: #e9c9a0; transform: rotate(-4deg); }
  .pics i:nth-child(2) { background: #bcd8c4; transform: rotate(2.5deg); }
  .pics i:nth-child(3) { background: #d8c6de; transform: rotate(-1.5deg); }
  .drop .big { font-family: var(--display); font-weight: 700; font-size: 19px; color: var(--ink); margin: 0 0 3px; max-width: none; }
  .drop .note { margin: 0; font-size: 13px; max-width: none; }
  .drop .under { margin: 9px 0 0; font-size: 12px; color: var(--ink3); max-width: none; }
  .drop .btn { margin-top: 16px; }

  .form { margin-top: 18px; border-top: 1px dashed var(--rule); }
  .row { display: flex; align-items: center; gap: 14px; padding: 10px 2px; border-bottom: 1px dashed var(--rule); flex-wrap: wrap; }
  .row label { font-size: 13px; color: var(--muted); min-width: 7.5em; }
  .row select, .row input {
    font-family: var(--body); font-size: 14px; color: var(--ink);
    padding: 7px 10px; background: #fff; border: 2px solid var(--rule);
    border-radius: 7px 3px 8px 4px / 4px 7px 3px 8px; flex: 1; min-width: 200px;
  }
  .row select:focus, .row input:focus { border-color: var(--tape); }
  .actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-top: 16px; }
  .link-btn { background: none; border: 0; color: var(--muted); font-family: var(--body); font-size: 13px; cursor: pointer; text-decoration: underline; }
  .count { font-size: 13px; color: var(--ink3); }

  .safe { margin-top: 16px; display: flex; gap: 9px; align-items: flex-start; font-size: 13.5px; color: var(--tape-d); max-width: none; }
  .safe svg { flex: none; margin-top: 5px; }

  section { margin-top: 40px; }
  h2 { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }

  .grid { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  .grid li { font-size: 11px; color: var(--ink3); display: flex; flex-direction: column; gap: 2px; }
  .grid img { width: 100%; height: auto; border: 2px solid var(--rule); border-radius: 4px; background: #fff; display: block; }
  .grid .fn { color: var(--muted); word-break: break-all; }
  .grid li.ng .fn { color: var(--stamp); }

  ol.steps { list-style: none; margin: 0; padding: 0; }
  ol.steps li { display: flex; gap: 12px; align-items: flex-start; padding: 7px 0; font-size: 14.5px; color: var(--muted); }
  ol.steps .n {
    flex: none; width: 27px; height: 27px; display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 13px; color: var(--kraft-deep);
    border: 2px solid var(--kraft); border-radius: 52% 48% 45% 55% / 48% 55% 45% 52%;
  }
  ol.steps li:nth-child(1) .n { transform: rotate(-3deg); }
  ol.steps li:nth-child(2) .n { transform: rotate(2deg); }
  ol.steps li:nth-child(3) .n { transform: rotate(-1deg); }

  ul.cant { margin: 0; padding: 0; list-style: none; max-width: 34em; }
  ul.cant li { font-size: 14.5px; color: var(--muted); padding: 5px 0 5px 18px; position: relative; }
  ul.cant li::before { content: ""; position: absolute; left: 0; top: .95em; width: 9px; height: 2px; background: var(--ink3); }

  .who { border-top: 2px solid var(--rule); padding-top: 20px; }
  ul.links { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; margin: 14px 0 0; padding: 0; }
  ul.links a { font-size: 14px; }
  .stamp-wrap { margin-top: 16px; }
</style>
