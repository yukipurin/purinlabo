---
import Base from '../../layouts/Base.astro';
import ToolShell from '../../components/ToolShell.astro';
import ToolFooter from '../../components/ToolFooter.astro';
import { square as t } from '../../content/imageTools';
import { tools } from '../../content/tools';
---
<Base title={t.seoTitle} description={t.seoDescription}>
  <div class="work">
    <ToolShell {...t} accept="image/*,.heic,.heif"
               figure="/img/tools/square-before-after.webp"
               figureAlt={tools.find((x) => x.slug === 'square')?.imageAlt}>
      <Fragment slot="settings">
        <div class="row">
          <label for="size">出力サイズ</label>
          <select id="size">
            <option value="1080" selected>1080 × 1080</option>
            <option value="1200">1200 × 1200</option>
            <option value="800">800 × 800</option>
          </select>
        </div>
        <div class="row">
          <label for="fill">余白の処理</label>
          <select id="fill">
            <option value="contain" selected>白で塗りつぶす（写真は切れません）</option>
            <option value="cover">正方形に切り抜く（はみ出す部分は切れます）</option>
          </select>
        </div>
        <div class="row">
          <label for="prefix">ファイル名</label>
          <input id="prefix" type="text" placeholder="空欄なら元のファイル名を使います" />
        </div>
      </Fragment>
    </ToolShell>
    <ToolFooter {...t} />
  </div>
</Base>

<script>
  import { setupTool, drawTo } from '../../lib/toolRunner';
  import { fitContain, fitCover } from '../../lib/square';
  import { outputName } from '../../lib/image';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;

  setupTool({
    zipName: 'square.zip',
    convert: async (file, i, total) => {
      const size = Number($('size').value);
      const mode = $('fill').value;
      const blob = await drawTo(file, size, size, 'image/jpeg', 0.92, (ctx, bitmap, w, h) => {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);
        if (mode === 'cover') {
          const s = fitCover(bitmap.width, bitmap.height, w);
          ctx.drawImage(bitmap, s.dx, s.dy, s.dw, s.dh, 0, 0, w, h);
        } else {
          const dst = fitContain(bitmap.width, bitmap.height, w);
          ctx.drawImage(bitmap, dst.dx, dst.dy, dst.dw, dst.dh);
        }
      });
      return { blob, name: outputName(file.name, i, total, 'jpg', { prefix: $('prefix').value }) };
    },
  });
</script>
