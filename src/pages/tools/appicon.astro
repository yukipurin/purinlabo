---
import Base from '../../layouts/Base.astro';
import ToolShell from '../../components/ToolShell.astro';
import ToolFooter from '../../components/ToolFooter.astro';
import { tools } from '../../content/tools';
import { appicon as t } from '../../content/imageTools';
---
<Base title={t.seoTitle} description={t.seoDescription}>
  <div class="work">
    <ToolShell {...t} category={{ slug: "image", name: "画像" }} figure="/img/tools/appicon.webp"
                figureAlt={tools.find((x) => x.slug === 'appicon')?.imageAlt} accept="image/*">
      <Fragment slot="settings">
        <div class="row">
          <label for="bg">透過</label>
          <select id="bg">
            <option value="white" selected>白で埋める（App Store はこちら）</option>
            <option value="keep">そのまま残す</option>
          </select>
        </div>
        <div class="row">
          <label for="store">書き出す先</label>
          <select id="store">
            <option value="all" selected>App Store と Google Play の両方</option>
            <option value="ios">App Store（iOS）だけ</option>
            <option value="android">Google Play（Android）だけ</option>
          </select>
        </div>
      </Fragment>
    </ToolShell>
    <ToolFooter {...t} />
  </div>
</Base>

<script>
  import { setupTool, drawTo } from '../../lib/toolRunner';
  import { APP_ICON_SIZES } from '../../lib/metadata';

  const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const ANDROID = new Set(['Google Play', 'Android', 'Android 小']);

  setupTool({
    zipName: 'appicon.zip',
    convert: async (file) => {
      const fill = $('bg').value === 'white';
      const store = $('store').value;
      const wanted = APP_ICON_SIZES.filter((s) =>
        store === 'all' ? true : store === 'android' ? ANDROID.has(s.label) : !ANDROID.has(s.label));

      const out = [];
      for (const { size, label } of wanted) {
        const blob = await drawTo(file, size, size, 'image/png', 1, (ctx, bitmap, w, h) => {
          if (fill) { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, w, h); }
          const scale = Math.min(w / bitmap.width, h / bitmap.height);
          const dw = Math.round(bitmap.width * scale);
          const dh = Math.round(bitmap.height * scale);
          ctx.drawImage(bitmap, Math.round((w - dw) / 2), Math.round((h - dh) / 2), dw, dh);
        });
        out.push({ blob, name: `icon-${size}.png`, note: label });
      }
      return out;
    },
  });
</script>

<style is:global>
  .tool .row .check-note { font-size: 13.5px; color: var(--muted); line-height: 1.8; flex: 1; min-width: 200px; }
</style>
