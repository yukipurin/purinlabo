---
import Base from '../../layouts/Base.astro';
import FileToolShell from '../../components/FileToolShell.astro';
import ToolFooter from '../../components/ToolFooter.astro';
import { pdfSplit as t } from '../../content/pdfTools';
---
<Base title={t.seoTitle} description={t.seoDescription}>
  <div class="work">
    <FileToolShell {...t} multiple={false} category={{ slug: 'pdf', name: 'PDF' }}
                   figure="/img/tools/pdf-split.webp"
                   figureAlt="1つのPDFが指定したページで切り分けられる様子">
      <Fragment slot="settings">
        <div class="row">
          <label for="mode">切り出し方</label>
          <select id="mode">
            <option value="pick" selected>ページを指定して1つに切り出す</option>
            <option value="every">決まったページ数ごとに分ける</option>
          </select>
        </div>
        <div class="row" id="rowPick">
          <label for="pages">ページの指定</label>
          <input id="pages" type="text" placeholder="例：1-3,7　空欄なら全ページ" />
        </div>
        <div class="row" id="rowEvery" hidden>
          <label for="size">何ページごと</label>
          <input id="size" type="number" value="1" min="1" max="500" />
        </div>
      </Fragment>
    </FileToolShell>
    <ToolFooter {...t} />
  </div>
</Base>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { setupFileTool } from '../../lib/fileRunner';
  import { parsePageRange, chunkPages, formatPageRange, outputPdfName } from '../../lib/pdf';

  const $ = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement;
  $('mode').addEventListener('change', () => {
    const every = $('mode').value === 'every';
    document.getElementById('rowPick')!.hidden = every;
    document.getElementById('rowEvery')!.hidden = !every;
  });

  async function build(src: PDFDocument, pages: number[]) {
    const out = await PDFDocument.create();
    const copied = await out.copyPages(src, pages.map((n) => n - 1));
    copied.forEach((p) => out.addPage(p));
    return new Blob([(await out.save()) as BlobPart], { type: 'application/pdf' });
  }

  setupFileTool({
    inspect: async (f) => (await PDFDocument.load(await f.arrayBuffer())).getPageCount(),
    run: async (files) => {
      const file = files[0].file;
      const src = await PDFDocument.load(await file.arrayBuffer());
      const total = src.getPageCount();

      if ($('mode').value === 'every') {
        const size = Number($('size').value) || 1;
        const groups = chunkPages(total, size);
        const made = [];
        for (const [i, pages] of groups.entries()) {
          made.push({
            name: outputPdfName(file.name, 'part', i),
            blob: await build(src, pages),
            note: `${formatPageRange(pages)} ページ`,
          });
        }
        return made;
      }

      const pages = parsePageRange($('pages').value, total);
      return [{
        name: outputPdfName(file.name, 'split'),
        blob: await build(src, pages),
        note: `${formatPageRange(pages)} ページ（${pages.length}枚）`,
      }];
    },
  });
</script>
