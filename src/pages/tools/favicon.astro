---
import Base from '../../layouts/Base.astro';
import ToolShell from '../../components/ToolShell.astro';
import ToolFooter from '../../components/ToolFooter.astro';
import { tools } from '../../content/tools';
import { favicon as t } from '../../content/imageTools';
---
<Base title={t.seoTitle} description={t.seoDescription}>
  <div class="work">
    <ToolShell {...t} figure="/img/tools/favicon.webp"
                figureAlt={tools.find((x) => x.slug === 'favicon')?.imageAlt} accept="image/*">
      <Fragment slot="settings">
        <div class="row">
          <label for="bg">背景</label>
          <select id="bg">
            <option value="keep" selected>透過のまま</option>
            <option value="white">白で埋める</option>
          </select>
        </div>
        <div class="row">
          <label>書き出すサイズ</label>
          <span class="check-note">16 / 32 / 48 / 180 / 192 / 512 px（タブ・ブックマーク・スマホのホーム画面）</span>
        </div>
      </Fragment>
    </ToolShell>
    <ToolFooter {...t} />
  </div>
</Base>

<script>
  import { setupTool, drawTo } from '../../lib/toolRunner';
  import { FAVICON_SIZES } from '../../lib/metadata';

  const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;

  setupTool({
    zipName: 'favicon.zip',
    convert: async (file) => {
      const fill = $('bg').value === 'white';
      const out = [];
      for (const size of FAVICON_SIZES) {
        const blob = await drawTo(file, size, size, 'image/png', 1, (ctx, bitmap, w, h) => {
          if (fill) { ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, w, h); }
          // 正方形でない画像は、はみ出さないように中央へ収める
          const scale = Math.min(w / bitmap.width, h / bitmap.height);
          const dw = Math.round(bitmap.width * scale);
          const dh = Math.round(bitmap.height * scale);
          ctx.drawImage(bitmap, Math.round((w - dw) / 2), Math.round((h - dh) / 2), dw, dh);
        });
        out.push({ blob, name: `favicon-${size}x${size}.png`, note: `${size} px` });
      }
      return out;
    },
  });
</script>

<style is:global>
  .tool .row .check-note { font-size: 13.5px; color: var(--muted); line-height: 1.8; flex: 1; min-width: 200px; }
</style>
