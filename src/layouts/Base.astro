---
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/ogp.png', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const siteName = 'ぷりんラボ';
const fullTitle = Astro.url.pathname === '/' ? title : `${title}｜${siteName}`;

const nav = [
  { href: '/tools/', label: 'ツール' },
  { href: '/#games', label: 'ゲーム' },
  { href: '/log/', label: 'お知らせ' },
  { href: '/about/', label: 'ぷりんラボとは' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  alternateName: 'Purin_Labo',
  url: 'https://purinlabo.com/',
  inLanguage: 'ja',
};
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@Purin_Labo" />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#faf4e8" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a class="skip" href="#main">本文へスキップ</a>

  <header class="site-head">
    <div class="hd">
      <a class="logo" href="/">ぷりんラボ</a>
      <nav aria-label="サイト内">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="ft">
      <a href="/tools/">ツール</a>
      <a href="/log/">お知らせ・開発記録</a>
      <a href="/privacy/">プライバシー</a>
      <a href="https://x.com/Purin_Labo" rel="noopener">X</a>
      <span class="c">© Purin_Labo</span>
    </div>
  </footer>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 0; background: var(--tape); color: #fff; padding: 8px 16px; z-index: 10; }
  .skip:focus { left: 0; }

  /* ヘッダーは限りなく引く。線は1本だけ、細く */
  .site-head { border-bottom: 1px solid rgba(184, 125, 69, .28); }
  .hd {
    max-width: var(--read); margin-inline: auto; padding: 0 28px;
    display: flex; align-items: center; justify-content: space-between;
    min-height: 78px; gap: 20px; flex-wrap: wrap;
  }
  .logo { font-family: var(--logo); font-size: 21px; color: var(--kraft); text-decoration: none; letter-spacing: .02em; }
  .site-head nav { display: flex; gap: 28px; }
  .site-head nav a {
    color: var(--muted); text-decoration: none;
    font-size: 12px; font-weight: 700; letter-spacing: .12em;
  }
  .site-head nav a:hover { color: var(--tape-d); }

  .site-foot { margin-top: 0; background: var(--ink); color: var(--muted-on-ink); }
  .ft {
    max-width: var(--read); margin-inline: auto; padding: 56px 28px 64px;
    display: flex; gap: 28px; flex-wrap: wrap; align-items: center;
    font-size: 12px; letter-spacing: .06em;
  }
  .site-foot a { color: var(--on-ink); text-decoration: none; font-weight: 700; }
  .site-foot a:hover { color: #8fd0ae; }
  .c { color: var(--muted-on-ink); margin-left: auto; }
  @media (max-width: 560px) { .c { margin-left: 0; } .hd { min-height: 64px; } .site-head nav { gap: 18px; } }
</style>
