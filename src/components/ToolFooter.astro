---
export interface Props {
  stepsTitle: string; steps: readonly string[];
  limitsTitle: string; limits: readonly string[];
  aboutTitle: string; about: readonly string[];
  aboutLinks: readonly { label: string; url: string }[];
}
const { stepsTitle, steps, limitsTitle, limits, aboutTitle, about, aboutLinks } = Astro.props;
---
<section>
  <h2>{stepsTitle}<span class="rule-wave"></span></h2>
  <ol class="steps">
    {steps.map((s, i) => <li><span class="n">{i + 1}</span><span>{s}</span></li>)}
  </ol>
</section>

<section>
  <h2>{limitsTitle}<span class="rule-wave"></span></h2>
  <ul class="cant">{limits.map((x) => <li>{x}</li>)}</ul>
</section>

<section class="who">
  <h2>{aboutTitle}<span class="rule-wave"></span></h2>
  {about.map((p) => <p>{p}</p>)}
  <ul class="links">{aboutLinks.map((l) => <li><a href={l.url} rel="noopener">{l.label}</a></li>)}</ul>
</section>

<style>
  section { margin-top: 40px; }
  h2 { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; font-size: 18px; }
  ol.steps { list-style: none; margin: 0; padding: 0; }
  ol.steps li { display: flex; gap: 12px; align-items: flex-start; padding: 7px 0; font-size: 14.5px; color: var(--muted); }
  ol.steps .n {
    flex: none; width: 27px; height: 27px; display: grid; place-items: center;
    font-family: var(--display); font-weight: 700; font-size: 13px; color: var(--kraft-deep);
    border: 2px solid var(--kraft); border-radius: 52% 48% 45% 55% / 48% 55% 45% 52%;
  }
  ol.steps li:nth-child(1) .n { transform: rotate(-3deg); }
  ol.steps li:nth-child(2) .n { transform: rotate(2deg); }
  ol.steps li:nth-child(3) .n { transform: rotate(-1deg); }
  ul.cant { margin: 0; padding: 0; list-style: none; max-width: 36em; }
  ul.cant li { font-size: 14.5px; color: var(--muted); padding: 5px 0 5px 18px; position: relative; }
  ul.cant li::before { content: ""; position: absolute; left: 0; top: .95em; width: 9px; height: 2px; background: var(--ink3); }
  .who { border-top: 2px solid var(--rule); padding-top: 20px; }
  .who p { font-size: 14.5px; color: var(--muted); }
  ul.links { display: flex; flex-wrap: wrap; gap: 8px 20px; list-style: none; margin: 14px 0 0; padding: 0; }
  ul.links a { font-size: 14px; }
</style>
